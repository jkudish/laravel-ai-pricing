{
    "name": "jkudish/laravel-ai-pricing",
    "description": "Shared, provenance-aware AI pricing and cost attribution for Laravel applications.",
    "keywords": [
        "Jkudish",
        "laravel",
        "laravel-ai-pricing"
    ],
    "homepage": "https://github.com/jkudish/laravel-ai-pricing",
    "license": "MIT",
    "authors": [
        {
            "name": "Joey Kudish",
            "email": "joachim.kudish@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "brick/math": "^0.14",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.9.5",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Jkudish\\LaravelAiPricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jkudish\\LaravelAiPricing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jkudish\\LaravelAiPricing\\LaravelAiPricingServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
